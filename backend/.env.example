# ===============================================
# Blood Report Analyzer - Backend Configuration
# ===============================================

# Ollama Endpoint (Zero external model APIs required)
OLLAMA_BASE_URL=https://ollama.calmalpha.in/
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODELS=phi4-mini:latest,granite4.1:3b,qwen3.5:4b-mlx

# Supabase Auth and Database Configuration
# (Optional: Backend automatically falls back to in-memory store if omitted)
SUPABASE_URL=
SUPABASE_KEY=

# Application Limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=50
ANALYSIS_DAILY_LIMIT=15
SESSION_TIMEOUT_MINUTES=30
