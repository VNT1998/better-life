# ===================================================
# BetterLife - Monorepo Environment Configuration
# ===================================================

# Environment mode: development, test, production
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-string-in-production

# Ollama Model Server Configuration (Self-hosted model endpoint)
OLLAMA_BASE_URL=https://ollama.calmalpha.in/
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODELS=phi4-mini:latest,granite4.1:3b,qwen3.5:4b-mlx

# Database Configuration (PostgreSQL or leave empty for SQLite)
DATABASE_URL=sqlite:///./betterlife_platform.db
# DATABASE_URL=postgresql://betterlife:betterlife_secret_password@localhost:5432/betterlife

# Redis Caching (Optional)
REDIS_URL=redis://localhost:6379/0

# Supabase Auth and Database Configuration (Optional: falls back to SQLite if omitted)
SUPABASE_URL=
SUPABASE_KEY=

# Application Limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=50
ANALYSIS_DAILY_LIMIT=15
SESSION_TIMEOUT_MINUTES=30

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_BASE_URL=/api
